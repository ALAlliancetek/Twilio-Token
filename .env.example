# Twilio Token Server - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# Required
# Your Twilio Account SID (from https://console.twilio.com -> Account Info)
TWILIO_ACCOUNT_SID=YOUR_ACCOUNT_SID
# API Key SID (create at https://console.twilio.com -> API Keys)
TWILIO_API_KEY_SID=YOUR_API_KEY_SID
# API Key Secret  <- KEEP THIS SECRET - server-side only
TWILIO_API_KEY_SECRET=YOUR_API_KEY_SECRET
# Voice (optional - only needed for voice calls)
# TwiML Application SID for outgoing calls (Voice -> TwiML Apps)
TWILIO_TWIML_APP_SID=YOUR_TWIML_APP_SID
# Push Credential SID for incoming call push (Voice -> Push Credentials)
TWILIO_PUSH_CREDENTIAL_SID=YOUR_PUSH_CREDENTIAL_SID
# Server
# Port the server listens on
PORT=3000
# Token TTL in seconds (default 3600 = 1 hour)
TOKEN_TTL=3600